# Existing lead / enquiry API endpoint (POST, JSON). Leave empty if none.
# Payload: { name, mobile, email, interest, msg }
VITE_API_URL=

# Optional public contact details. Anything left empty is simply not shown.
VITE_PHONE=
VITE_EMAIL=
VITE_ADDRESS=
# WhatsApp number with country code, digits only (e.g. 9198XXXXXXXX). Empty = WhatsApp opens its contact picker.
VITE_WHATSAPP_NUMBER=
